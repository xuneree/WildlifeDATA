    {
      "name": "data_retrieval_status",
      "type": "VARCHAR(20)",
      "required": "必填",
      "default": "—",
      "description": "retrieved / not_retrieved"
    },
    {
      "name": "issue_type",
      "type": "VARCHAR(50)",
      "required": "可空",
      "default": "—",
      "description": "异常主类型，正常为空"
    },
    {
      "name": "notes",
      "type": "TEXT",
      "required": "可空",
      "default": "—",
      "description": "其他异常或回收说明"
    }
  ],
  "media_asset": [
    {
      "name": "id",
