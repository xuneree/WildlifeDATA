{
  "camera_site": [
    {
      "name": "id",
      "type": "UUID",
      "required": "必填",
      "default": "—",
      "description": "主键"
    },
    {
      "name": "site_code",
      "type": "VARCHAR(50)",
      "required": "必填",
      "default": "—",
      "description": "位点业务编号；推荐在当前单区域体系下唯一"
    },
    {
      "name": "region",
      "type": "VARCHAR(100)",
      "required": "必填",
      "default": "—",
      "description": "监测区域"
    },
    {
      "name": "first_deployed_at",
      "type": "TIMESTAMPTZ",
      "required": "可空",
      "default": "—",
      "description": "位点首次布设时间"
    },
    {
      "name": "deployment_type",
      "type": "VARCHAR(20)",
      "required": "必填",
      "default": "—",
      "description": "single / paired"
    },
    {
      "name": "longitude",
      "type": "DOUBLE PRECISION",
      "required": "可空",
      "default": "—",
      "description": "WGS84 经度；-180 到 180"
    },
    {
      "name": "latitude",
      "type": "DOUBLE PRECISION",
      "required": "可空",
      "default": "—",
      "description": "WGS84 纬度；-90 到 90"
    },
    {
      "name": "elevation_m",
      "type": "NUMERIC(8,2)",
      "required": "可空",
      "default": "—",
      "description": "海拔（米）"
    },
    {
      "name": "terrain_type",
      "type": "VARCHAR(50)",
      "required": "可空",
      "default": "—",
      "description": "地形类型"
    },
    {
      "name": "vegetation_type",
      "type": "VARCHAR(100)",
      "required": "可空",
      "default": "—",
      "description": "植被类型"
    },
    {
      "name": "environment_type",
      "type": "VARCHAR(100)",
      "required": "可空",
      "default": "—",
      "description": "兽径/道路等"
    },
    {
      "name": "notes",
      "type": "TEXT",
      "required": "可空",
      "default": "—",
      "description": "备注"
    }
  ],
  "camera_deployment": [
    {
      "name": "id",
      "type": "UUID",
