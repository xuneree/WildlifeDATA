    {
      "name": "data_retrieval_at",
      "type": "TIMESTAMPTZ",
      "required": "可空",
      "default": "—",
      "description": "期末取回数据的日期"
    },
    {
      "name": "data_retrieval_batch",
      "type": "VARCHAR(20)",
      "required": "必填",
      "default": "—",
      "description": "如 202608"
