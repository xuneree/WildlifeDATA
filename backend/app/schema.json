    },
    {
      "name": "file_hash",
      "type": "VARCHAR(64)",
      "required": "可空",
      "default": "—",
      "description": "SHA-256 文件哈希，支持一致性核验"
    },
    {
      "name": "captured_at",
      "type": "TIMESTAMPTZ",
      "required": "可空",
      "default": "—",
