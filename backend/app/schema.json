      "name": "duration_seconds",
      "type": "NUMERIC(12,3)",
      "required": "可空",
      "default": "—",
      "description": "视频时长，图片为空"
    },
    {
      "name": "width",
      "type": "INTEGER",
      "required": "可空",
      "default": "—",
      "description": "宽度像素"
    },
    {
      "name": "height",
      "type": "INTEGER",
      "required": "可空",
      "default": "—",
      "description": "高度像素"
    },
    {
      "name": "codec",
      "type": "VARCHAR(50)",
      "required": "可空",
      "default": "—",
      "description": "视频编码"
    },
    {
      "name": "individual_annotation_status",
      "type": "VARCHAR(20)",
      "required": "必填",
      "default": "unannotated",
      "description": "unannotated / annotated"
    },
    {
      "name": "created_at",
      "type": "TIMESTAMPTZ",
      "required": "必填",
      "default": "now()",
      "description": "首次纳入平台时间"
    },
    {
      "name": "notes",
      "type": "TEXT",
      "required": "可空",
      "default": "—",
      "description": "备注"
    }
  ],
